{
  "$defs": {
    "Location": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Function"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line",
        "function"
      ],
      "title": "Location",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "location": {
            "$ref": "#/$defs/Location"
          }
        }
      },
      "if": {
        "properties": {
          "verdict": {
            "const": "ABSENT"
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "analysis": {
      "maxLength": 1200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Analysis",
      "type": "string"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Location"
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "enum": [
        "PRESENT",
        "ABSENT"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "analysis",
    "verdict",
    "location"
  ],
  "title": "ScopedReport",
  "type": "object"
}
