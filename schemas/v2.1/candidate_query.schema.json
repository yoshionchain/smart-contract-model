{
  "$defs": {
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "end_token": {
          "title": "End Token",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "FILE",
            "CONTRACT",
            "FUNCTION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "2.1",
          "default": "2.1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "start_token": {
          "title": "Start Token",
          "type": "integer"
        },
        "token_identity": {
          "title": "Token Identity",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "start_line",
        "end_line",
        "start_token",
        "end_token",
        "token_identity"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "assessment_ids": {
      "items": {
        "type": "string"
      },
      "title": "Assessment Ids",
      "type": "array"
    },
    "check_id": {
      "const": "REENTRANCY",
      "title": "Check Id",
      "type": "string"
    },
    "code_identity_sha256": {
      "title": "Code Identity Sha256",
      "type": "string"
    },
    "group_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Group Id"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "mechanical_status": {
      "enum": [
        "PASS",
        "EXCLUDED"
      ],
      "title": "Mechanical Status",
      "type": "string"
    },
    "model_input_sha256": {
      "title": "Model Input Sha256",
      "type": "string"
    },
    "native_verdicts": {
      "items": {
        "enum": [
          "PRESENT",
          "ABSENT",
          "UNKNOWN"
        ],
        "type": "string"
      },
      "title": "Native Verdicts",
      "type": "array"
    },
    "original_collections": {
      "items": {
        "type": "string"
      },
      "title": "Original Collections",
      "type": "array"
    },
    "proposed_verdict": {
      "enum": [
        "PRESENT",
        "ABSENT",
        "UNKNOWN"
      ],
      "title": "Proposed Verdict",
      "type": "string"
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "review_required": {
      "items": {
        "type": "string"
      },
      "title": "Review Required",
      "type": "array"
    },
    "role": {
      "enum": [
        "development",
        "smartbugs_external",
        "forge_external"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "2.1",
      "default": "2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "training_ready": {
      "const": false,
      "default": false,
      "title": "Training Ready",
      "type": "boolean"
    }
  },
  "required": [
    "query_id",
    "artifact_id",
    "assessment_ids",
    "code_identity_sha256",
    "check_id",
    "scope",
    "native_verdicts",
    "proposed_verdict",
    "role",
    "original_collections",
    "mechanical_status",
    "issues",
    "review_required",
    "model_input_sha256"
  ],
  "title": "CandidateQuery",
  "type": "object"
}
