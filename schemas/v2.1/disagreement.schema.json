{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessment_ids": {
      "items": {
        "type": "string"
      },
      "title": "Assessment Ids",
      "type": "array"
    },
    "check_id": {
      "const": "REENTRANCY",
      "title": "Check Id",
      "type": "string"
    },
    "code_identity_sha256": {
      "title": "Code Identity Sha256",
      "type": "string"
    },
    "disagreement_id": {
      "title": "Disagreement Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "same_property_conflict",
        "cross_property_disagreement"
      ],
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "2.1",
      "default": "2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "UNRESOLVED",
      "default": "UNRESOLVED",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "disagreement_id",
    "code_identity_sha256",
    "check_id",
    "assessment_ids",
    "kind"
  ],
  "title": "Disagreement",
  "type": "object"
}
