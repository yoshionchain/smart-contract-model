{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ancestry_known": {
      "default": false,
      "title": "Ancestry Known",
      "type": "boolean"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "code": {
      "default": "",
      "title": "Code",
      "type": "string"
    },
    "code_identity_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Identity Sha256"
    },
    "code_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Sha256"
    },
    "code_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Tokens"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "line_count": {
      "default": 0,
      "title": "Line Count",
      "type": "integer"
    },
    "original_collection": {
      "title": "Original Collection",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "project_keys": {
      "items": {
        "type": "string"
      },
      "title": "Project Keys",
      "type": "array"
    },
    "raw_sha256": {
      "title": "Raw Sha256",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "role": {
      "enum": [
        "development",
        "smartbugs_external",
        "forge_external"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "2.1",
      "default": "2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "source_input_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Input Sha256"
    }
  },
  "required": [
    "artifact_id",
    "source",
    "revision",
    "path",
    "original_collection",
    "role",
    "raw_sha256"
  ],
  "title": "Artifact",
  "type": "object"
}
